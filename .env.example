# X session for the bookmarks collector. Copy this file to `.env` (same folder, git-ignored)
# and paste the two cookie values from a browser where you are logged in to X:
# DevTools > Application > Cookies > https://x.com. Both must come from the same browser session.
# auth_token is equivalent to your X password: never commit, paste in chat, or share this file.
X_AUTH_TOKEN=
X_CT0=
